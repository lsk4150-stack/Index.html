*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f4fff4;
    color:#333;
    line-height:1.6;
}

header{
    background:#1b7a32;
    color:#fff;
    padding:20px;
    text-align:center;
}

header h1{
    font-size:40px;
}

header p{
    margin-top:10px;
    font-size:18px;
}

nav{
    margin-top:20px;
}

nav a{
    color:#fff;
    text-decoration:none;
    margin:0 15px;
    font-weight:bold;
}

nav a:hover{
    color:yellow;
}

.hero{
    background:#2e8b57;
    color:white;
    text-align:center;
    padding:80px 20px;
}

.hero h2{
    font-size:36px;
}

.hero p{
    margin-top:15px;
    font-size:18px;
}

.btn{
    display:inline-block;
    margin:10px;
    padding:12px 25px;
    background:#ffcc00;
    color:#000;
    text-decoration:none;
    border-radius:6px;
    font-weight:bold;
}

.btn:hover{
    background:#ffaa00;
}

.container{
    width:90%;
    max-width:1200px;
    margin:auto;
}

section{
    padding:50px 0;
}

h2{
    color:#1b7a32;
    margin-bottom:20px;
}

ul{
    padding-left:20px;
}

footer{
    background:#1b7a32;
    color:white;
    text-align:center;
    padding:20px;
    margin-top:30px;
}

@media(max-width:768px){

header h1{
    font-size:28px;
}

.hero h2{
    font-size:28px;
}

nav a{
    display:block;
    margin:10px 0;
}

}
